<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Identity 2FA Demo</title>
    <style>
        :root { --bg:#0f172a; --card:#1e293b; --text:#e2e8f0; --muted:#94a3b8; --accent:#38bdf8; --ok:#4ade80; --err:#f87171; }
        * { box-sizing: border-box; }
        body { margin:0; font-family:Segoe UI,system-ui,sans-serif; background:linear-gradient(160deg,#0f172a,#1e3a5f); color:var(--text); min-height:100vh; }
        header { padding:1rem 1.5rem; border-bottom:1px solid #334155; display:flex; gap:1rem; align-items:center; justify-content:space-between; }
        header a { color:var(--accent); text-decoration:none; margin-right:.75rem; }
        main { max-width:640px; margin:2rem auto; padding:0 1rem; }
        .card { background:var(--card); border:1px solid #334155; border-radius:12px; padding:1.5rem; }
        h1,h2 { margin-top:0; }
        label { display:block; margin:.75rem 0 .25rem; color:var(--muted); font-size:.9rem; }
        input[type=text], input[type=password], input[type=email] { width:100%; padding:.6rem .75rem; border-radius:8px; border:1px solid #475569; background:#0f172a; color:var(--text); }
        button, .btn { display:inline-block; margin-top:1rem; padding:.6rem 1rem; border:0; border-radius:8px; background:var(--accent); color:#0f172a; font-weight:600; cursor:pointer; text-decoration:none; }
        .muted { color:var(--muted); font-size:.9rem; }
        .ok { color:var(--ok); }
        .err { color:var(--err); }
        .code { font-family:ui-monospace,Consolas,monospace; background:#0f172a; padding:.75rem; border-radius:8px; word-break:break-all; }
        ul.validation-summary-errors { color:var(--err); }
    </style>
</head>
<body>
<header>
    <div>
        <strong>Identity2FA_Demo</strong>
        <span class="muted">原生 ASP.NET Core Identity + SQLite</span>
    </div>
    <nav>
        <a asp-page="/Index">首页</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-page="/Account/Manage2FA">管理 2FA</a>
            <a asp-page="/Account/Logout">退出</a>
            <span class="muted">@User.Identity?.Name</span>
        }
        else
        {
            <a asp-page="/Account/Register">注册</a>
            <a asp-page="/Account/Login">登录</a>
        }
    </nav>
</header>
<main>
    @RenderBody()
</main>
</body>
</html>
